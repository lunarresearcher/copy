{
  "name": "copy-robinhood-cli",
  "version": "2.0.0",
  "description": "Working CLI-first copytrade terminal for Robinhood Chain with live token discovery, profit hunters, COPY wallets, paper positions, and a native execution queue.",
  "type": "module",
  "bin": {
    "copy": "./bin/copy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/copy.mjs terminal",
    "terminal": "node bin/copy.mjs terminal",
    "hunt": "node bin/copy.mjs hunt",
    "paper": "node bin/copy.mjs paper",
    "doctor": "node bin/copy.mjs doctor --probe",
    "demo": "node bin/copy.mjs terminal --demo",
    "web": "node server.mjs",
    "test": "node scripts/smoke-test.mjs && node scripts/cli-test.mjs",
    "preview:terminal": "node scripts/generate-terminal-preview.mjs",
    "showcase": "node bin/copy.mjs terminal --demo",
    "github:setup": "bash scripts/github-setup.sh"
  },
  "keywords": [
    "robinhood-chain",
    "copytrade",
    "terminal",
    "fomo",
    "smart-money",
    "crypto"
  ],
  "license": "MIT"
}
