# Preferred for an unattended 24/7 Fomo leaderboard + trade feed.
REPLYNODES_API_KEY=
REPLYNODES_FOMO_CHAIN=robinhood

# Alternative: direct Fomo web session API + WebSocket.
# Keep this server-side; rotate it when the Fomo session expires.
FOMO_BEARER_TOKEN=

# Robinhood Chain RPC. Use a production provider for 24/7 deployment.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_RPC_FALLBACK=https://rpc.mainnet.chain.robinhood.com
RH_INITIAL_LOOKBACK=24000

# DexScreener is keyless and is used for real Robinhood token profiles,
# websites, charts, price, liquidity, volume and market cap.
POLL_DEX_MS=15000

PORT=8787
POLL_FOMO_MS=15000
POLL_CHAIN_MS=5000
CACHE_FILE=./data/cache.json

# Native execution. Browser wallet connection is never used.
# Leave blank to run COPY in persistent native queue mode.
# Point this at your own relayer/executor service for live broadcasts.
NATIVE_EXECUTOR_WEBHOOK=
NATIVE_EXECUTOR_TOKEN=
NATIVE_EXECUTOR_POLL_MS=1500
